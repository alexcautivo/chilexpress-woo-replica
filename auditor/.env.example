# Auditor multiplataforma Chilexpress — ejemplo sin secretos reales (§30).
# Copiar a .env solo si se prefiere configurar por entorno en lugar de
# `node bin/auditor.mjs ai configure`.

# --- IA opcional -------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
AI_ANALYSIS_LEVEL=STANDARD
AI_MAX_REQUESTS=3
AI_MAX_TOKENS=1200
AI_TIMEOUT=45000
AI_DEEP_CONSENT=false
# Nunca subir la key real a git ni ponerla en el Dockerfile.
ANTHROPIC_API_KEY=

# --- Laboratorio WooCommerce -------------------------------------------------
AUDITOR_WP_IMAGE=wordpress:6.8-php8.3-apache
AUDITOR_WPCLI_IMAGE=wordpress:cli-php8.3
AUDITOR_DB_IMAGE=mariadb:11.4
AUDITOR_WP_PORT=8181

# --- Laboratorio PrestaShop --------------------------------------------------
AUDITOR_PS_IMAGE=prestashop/prestashop:8.1-apache
AUDITOR_PS_PORT=8182

# --- Laboratorio Magento -----------------------------------------------------
# Requiere una imagen construida con Composer autenticado.
AUDITOR_MAGENTO_IMAGE=
AUDITOR_MAGENTO_PORT=8183

# --- Sondas Shopify ----------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_ACCESS_TOKEN=
