# Copia a .env y ajusta. Usado por docker compose.

# Pila del cliente SR-108688 / celularesenventa.cl
PHP_VERSION=8.4.19
WP_VERSION=7.0.3
WC_VERSION=11.0.1
CXP_VERSION=1.4.0

WORDPRESS_PORT=8080
WP_HOME=http://127.0.0.1:8080

# sqlite (default de la réplica local) o mysql (servicio db con profile)
DB_ENGINE=sqlite

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=wordpress
WORDPRESS_DB_HOST=db
