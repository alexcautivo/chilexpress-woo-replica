      {
        "id": "activar-woo",
        "op": "activate_plugin",
        "slug": "woocommerce",
        "descripcion": "WooCommerce 9.8.5."
      },
      {
        "id": "activar-cxp",
        "op": "activate_plugin",
        "slug": "chilexpress-oficial",
        "descripcion": "Chilexpress desde repo."
      },
      {
        "id": "limpiar-caches",
        "op": "clear_cache",
        "alcance": "transients",
        "descripcion": "Transients de sesion/carrito de laboratorio."
      },
      {
        "id": "abrir-checkout",
        "op": "open_url",
        "url": "/checkout/",
        "descripcion": "Checkout clasico Storefront."
      },
      {
        "id": "esperar-fragmentos",
        "op": "wait",
        "segundos": 2,
        "descripcion": "Espera corta para fragmentos de Woo."
      },
      {
        "id": "texto-cobertura",
        "op": "assert_text",
        "texto": "no hay cobertura",
        "descripcion": "El aviso reportado por el ejemplo."
      }
    ],
    "assertions": [
      {
        "id": "http-checkout-ok",
        "tipo": "http_status",
        "esperado": 200,
        "paso": "abrir-checkout"
      },
      {
        "id": "cuerpo-aviso",
        "tipo": "body_contains",
        "esperado": "no hay cobertura",
        "paso": "abrir-checkout"
      },
      {
        "id": "sin-fatal",
        "tipo": "body_not_contains",
        "esperado": "Ha habido un error critico",
        "paso": "abrir-checkout"
      }
    ],
    "politicas": {
      "timeout_segundos": 120,
      "max_pasos": 20,
      "limpiar_carrito": true,
      "limpiar_transients": true,
      "conservar_pedidos": true,
      "restaurar_al_finalizar": true,
      "versiones_exactas": true,
      "permitir_latest": false,
      "proteger_mu_cxp": true,
      "proteger_sqlite": true,
      "no_parchear_chilexpress": true
    }
