# Copia a .env y ajusta. Usado por docker compose y por Dokploy.

# Pila del cliente SR-108688 / celularesenventa.cl
PHP_VERSION=8.4.19
WP_VERSION=7.0.3
WC_VERSION=11.0.1
CXP_VERSION=1.4.0

WORDPRESS_PORT=8080
# En Dokploy: la URL pública https://tu-dominio (con https, sin barra final)
WP_HOME=http://127.0.0.1:8080

# sqlite (default) o mysql (profile mysql)
DB_ENGINE=sqlite

# 1 = entra a wp-admin como admin sin login (solo local / red privada)
# 0 = pide usuario y contraseña (obligatorio si el sitio está en Internet)
CXP_AUTO_LOGIN=1

# Opcional: URL de otro shop de prueba para el botón "Pedidos remota"
CXP_REMOTE_SHOP_URL=

# Subscription keys de staging (portal developers.wschilexpress.com)
# No las subas al repo. En Dokploy pégalas como Environment.
CXP_API_KEY_GEO=
CXP_API_KEY_RATE=
CXP_API_KEY_OT=

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=wordpress
WORDPRESS_DB_HOST=db
